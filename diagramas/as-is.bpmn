<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_AsIs">
    <bpmn:participant id="Participant_Brookies" name="Brookies Coffee" processRef="Process_AsIs" />
    <bpmn:participant id="Participant_Prov" name="Proveedor o tienda" />
    <bpmn:messageFlow id="M1" name="Compra de insumos" sourceRef="A11" targetRef="Participant_Prov" />
  </bpmn:collaboration>
  <bpmn:process id="Process_AsIs" name="Control y reabastecimiento de inventario de insumos (AS-IS, sin el gestor)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Caja" name="Personal de caja">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A05</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Barista" name="Barista">
        <bpmn:flowNodeRef>A02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A03</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administrador (dueño)">
        <bpmn:flowNodeRef>A06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Cliente hace un pedido">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="A01" name="Anotar la comanda a mano">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A04" name="Entregar y cobrar el pedido">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E1" name="Pedido entregado">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Al cerrar el día">
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S2" />
    </bpmn:startEvent>
    <bpmn:manualTask id="A05" name="Cuadrar la caja">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A02" name="Preparar el pedido con la receta">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G1" name="¿Alcanzan los insumos?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A03" name="Avisar que falta un insumo">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A06" name="Registrar ventas y rebaja de insumos en Excel">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E3" name="Día cerrado">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S3" name="Cada semana">
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S3" />
    </bpmn:startEvent>
    <bpmn:manualTask id="A07" name="Contar el inventario a mano">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="A08" name="Anotar el conteo en planilla Excel">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="A09" name="Estimar al ojo cuánto comprar">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G2" name="¿Faltan insumos?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A10" name="Buscar dónde comprar más barato">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A11" name="Comprar los insumos">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A12" name="Guardar los insumos">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E4" name="Inventario repuesto">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E5" name="Inventario revisado">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="A01" />
    <bpmn:sequenceFlow id="F2" sourceRef="A01" targetRef="A02" />
