    <bpmn:sequenceFlow id="F12" sourceRef="A07" targetRef="A08" />
    <bpmn:sequenceFlow id="F13" sourceRef="A08" targetRef="A09" />
    <bpmn:sequenceFlow id="F14" sourceRef="A09" targetRef="G2" />
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="G2" targetRef="A10" />
    <bpmn:sequenceFlow id="F16" name="No" sourceRef="G2" targetRef="E5" />
    <bpmn:sequenceFlow id="F17" sourceRef="A10" targetRef="A11" />
    <bpmn:sequenceFlow id="F18" sourceRef="A11" targetRef="A12" />
    <bpmn:sequenceFlow id="F19" sourceRef="A12" targetRef="E4" />
  </bpmn:process>
