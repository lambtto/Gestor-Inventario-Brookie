    <bpmn:sequenceFlow id="F8" sourceRef="N01" targetRef="G3" />
    <bpmn:sequenceFlow id="F9" name="Sí" sourceRef="G3" targetRef="N02" />
    <bpmn:sequenceFlow id="F10" name="No" sourceRef="G3" targetRef="E6" />
    <bpmn:sequenceFlow id="F11" sourceRef="N02" targetRef="N03" />
    <bpmn:sequenceFlow id="F12" sourceRef="S5" targetRef="N05" />
    <bpmn:sequenceFlow id="F13" sourceRef="N05" targetRef="E8" />
    <bpmn:sequenceFlow id="F14" sourceRef="SA" targetRef="N03" />
    <bpmn:sequenceFlow id="F15" sourceRef="N03" targetRef="G2" />
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="G2" targetRef="A10" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="G2" targetRef="E5" />
    <bpmn:sequenceFlow id="F18" sourceRef="A10" targetRef="A11" />
    <bpmn:sequenceFlow id="F19" sourceRef="A11" targetRef="N04" />
    <bpmn:sequenceFlow id="F20" sourceRef="N04" targetRef="E4" />
  </bpmn:process>
