<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Brookies" name="Brookies Coffee (con el gestor)" processRef="Process_ToBe" />
    <bpmn:participant id="Participant_Prov" name="Proveedor o tienda" />
    <bpmn:messageFlow id="M1" name="Compra de insumos" sourceRef="A11" targetRef="Participant_Prov" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" name="Control y reabastecimiento de inventario de insumos (TO-BE, con el gestor)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Caja" name="Personal de caja">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Barista" name="Barista">
        <bpmn:flowNodeRef>A02</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="Sistema de inventario">
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administrador (dueño)">
        <bpmn:flowNodeRef>S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Cliente hace un pedido">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="A01" name="Anotar la comanda a mano">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A04" name="Entregar y cobrar el pedido">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E1" name="Pedido entregado">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Al cerrar el día">
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_S2" />
    </bpmn:startEvent>
    <bpmn:manualTask id="A05" name="Cuadrar la caja">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E7" name="Caja cuadrada">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="A02" name="Preparar el pedido con la receta">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:startEvent id="S4" name="Pedido confirmado">
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="N01" name="Descontar insumos y registrar venta">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="¿Stock en o bajo el mínimo?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N02" name="Alertar stock crítico">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E6" name="Stock actualizado">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S5" name="Nuevo insumo o producto">
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="N05" name="Registrar insumos y recetas">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E8" name="Recetas registradas">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SA" name="Al cerrar el día">
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_SA" />
    </bpmn:startEvent>
    <bpmn:userTask id="N03" name="Revisar inventario, ventas y decidir reposición">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Hay que reponer?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="A10" name="Buscar dónde comprar más barato">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="A11" name="Comprar los insumos">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="N04" name="Reabastecer stock">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E4" name="Inventario repuesto">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E5" name="Inventario revisado">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="A01" />
    <bpmn:sequenceFlow id="F2" sourceRef="A01" targetRef="A02" />
