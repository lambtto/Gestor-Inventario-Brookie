@startuml est-01
title EST-01 Ciclo de vida de Insumo
skinparam dpi 140
skinparam nodesep 90
skinparam ranksep 70
state "Stock suficiente" as Suf
state "Stock crítico" as Cri
state "Desactivado" as Des

Suf : stockActual > stockMinimo
Suf : --
Suf : Pedido confirmado [stock resultante > mínimo]
Suf : Registrar ingreso
Suf : Ajustar stock [stock resultante > mínimo]
Suf : Editar insumo [stock > nuevo mínimo]
Cri : stockActual <= stockMinimo
Cri : --
Cri : Pedido confirmado / no genera otra alerta
Cri : Registrar ingreso [stock resultante ≤ mínimo] / la alerta sigue vigente
Cri : Ajustar stock [stock resultante ≤ mínimo] / la alerta sigue vigente
Cri : Editar insumo [stock ≤ nuevo mínimo] / la alerta sigue vigente
Des : activo = falso
Des : --
Des : Pedido confirmado [sigue en una receta] / descontar, sin alerta
Des : Ajustar stock / sin alerta
Des : Editar insumo / sin alerta

[*] --> Cri : Registrar insumo / generar alerta
Suf --> Cri : Pedido confirmado\n[stock resultante ≤ mínimo] / generar alerta
Cri --> Suf : Registrar ingreso\n[stock resultante > mínimo] / resolver alerta
Suf --> Des : Desactivar insumo
Cri --> Des : Desactivar insumo / resolver alerta
Suf --> [*] : Eliminar insumo\n[no forma parte de ninguna receta\ny no tiene movimientos]
Cri --> [*] : Eliminar insumo\n[no forma parte de ninguna receta\ny no tiene movimientos]\n/ eliminar alerta
Des --> [*] : Eliminar insumo\n[no forma parte de ninguna receta\ny no tiene movimientos]
Des --> Cri : Reactivar insumo\n[stock ≤ mínimo] / generar alerta
Des --> Suf : Reactivar insumo\n[stock > mínimo]
Suf --> Cri : Editar insumo\n[stock ≤ nuevo mínimo] / generar alerta
Cri --> Suf : Editar insumo\n[stock > nuevo mínimo] / resolver alerta
Suf --> Cri : Ajustar stock\n[stock resultante ≤ mínimo] / generar alerta
Cri --> Suf : Ajustar stock\n[stock resultante > mínimo] / resolver alerta
@enduml
